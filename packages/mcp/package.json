{
  "name": "@tokenscout/mcp",
  "version": "0.1.0",
  "description": "MCP stdio server for tokenscout — expose design token extraction to Claude Code, Cursor, and Windsurf.",
  "type": "module",
  "bin": { "tokenscout-mcp": "./dist/index.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": ["mcp", "design-tokens", "tokenscout", "claude-code", "cursor", "windsurf"],
  "license": "MIT",
  "author": "Hugo Carvalho (@Atroci)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atroci/tokenscout.git",
    "directory": "packages/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@tokenscout/extract": "^0.3.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.60.0"
  },
  "engines": { "node": ">=20" }
}
