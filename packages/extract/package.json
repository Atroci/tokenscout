{
  "name": "@tokenscout/extract",
  "version": "0.6.0",
  "description": "Turn an undocumented live website into an evidence-backed redesign baseline for scoping and rebuilding.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "playwright",
    "css",
    "computed-style",
    "website-audit",
    "website-redesign",
    "website-migration",
    "web-agency",
    "tokenscout"
  ],
  "license": "MIT",
  "author": "Hugo Carvalho (@Atroci)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atroci/tokenscout.git",
    "directory": "packages/extract"
  },
  "dependencies": {
    "tokenscout": "^0.6.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.60.0"
  },
  "engines": {
    "node": ">=20"
  }
}
