{
  "name": "@tokenscout/transform",
  "version": "0.1.0",
  "description": "Render the token layer of a TokenScout redesign baseline as CSS variables or Tailwind config.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "design-tokens",
    "css",
    "tailwind",
    "css-variables",
    "design-system",
    "website-redesign",
    "tokenscout"
  ],
  "license": "MIT",
  "author": "Hugo Carvalho (@Atroci)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atroci/tokenscout.git",
    "directory": "packages/transform"
  },
  "dependencies": {
    "tokenscout": "^0.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
